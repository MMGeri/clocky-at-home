# Server port — in production set to 80 or proxy with nginx
PORT=3001

# Allowed frontend origin for CORS.
# In production: your public domain (no trailing slash)
# In dev: http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Set to "production" when deploying
NODE_ENV=development

# Optional: absolute path to store clockify.db
# Defaults to <project>/data/ if left empty
# DATA_DIR=/var/lib/ftx-clockify
